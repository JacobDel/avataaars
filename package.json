{
  "name": "avataaars",
  "version": "2.1.3",
  "description": "React component for avataaars",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest"
  },
  "keywords": [
    "react",
    "avatar"
  ],
  "repository": "git@github.com:fangpenlin/avataaars.git",
  "author": "Fang-Pen Lin <hello@fangpenlin.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6",
    "@testing-library/react": "16",
    "@types/jest": "29",
    "@types/react": "^19.0.0",
    "import-sort-style-renke": "^4.2.0",
    "jest": "29",
    "jest-environment-jsdom": "29",
    "react": "19.2.0",
    "ts-jest": "29",
    "tslint": "^6.1.3",
    "tslint-config-standard": "^9.0.0",
    "tslint-react": "^5.0.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "lodash": ">=4.17.21",
    "prop-types": "^15.7.2",
    "react-dom": "19.2.0"
  },
  "importSort": {
    ".js, .jsx, .es6, .es": {
      "parser": "babylon",
      "style": "import-sort-style-renke"
    },
    ".ts, .tsx": {
      "parser": "typescript",
      "style": "import-sort-style-renke"
    }
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "jsxBracketSameLine": true
  }
}
